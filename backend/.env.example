# ===================================================
# InsightAI — Backend Environment Variables Template
# ===================================================
# Copy file này thành .env và điền giá trị thực tế:
#   cp .env.example .env

# ---------------------------------------------------
# AI Provider API Keys (chọn 1 hoặc cả 2)
# ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GOOGLE_API_KEY=AIza...

# ---------------------------------------------------
# Default Model
# ---------------------------------------------------
DEFAULT_MODEL=gpt-4o-mini
# Các lựa chọn khác:
# DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# ---------------------------------------------------
# Logging
# ---------------------------------------------------
LOG_LEVEL=INFO

# AI Hook Logging (được cấu hình bởi instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your_ai_log_api_key
AI_LOG_DIR=.ai-log

# ---------------------------------------------------
# Database — Supabase PostgreSQL
# ---------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:6543/postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=your_db_password
POSTGRES_SERVER=<host>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ---------------------------------------------------
# Supabase
# ---------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # Service Role Key từ Supabase Dashboard

# ---------------------------------------------------
# Vector Database — Milvus (Zilliz Cloud hoặc self-hosted)
# ---------------------------------------------------
MILVUS_URI=https://in03-xxx.serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_TOKEN=your_milvus_api_token
MILVUS_COLLECTION=insight_agentic
USE_MILVUS_FOR_SEARCH=true

# (Legacy) ChromaDB path — chỉ dùng nếu không dùng Milvus
CHROMA_DB_PATH=./chroma_db

# ---------------------------------------------------
# Azure Cognitive Services — Text-to-Speech
# ---------------------------------------------------
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastasia
# Các region khác: southeastasia, eastus, westeurope

# ---------------------------------------------------
# Tavily Web Search — Fallback cho Agentic RAG
# ---------------------------------------------------
TAVILY_API_KEY=tvly-...

# ---------------------------------------------------
# LangSmith Tracing (Observability)
# ---------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=A20_App_152

# ---------------------------------------------------
# Payment Gateways (ZaloPay, MoMo, VietQR)
# ---------------------------------------------------
APP_BASE_URL=https://your-domain.vercel.app # URL của frontend để redirect về

MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://your-domain.vercel.app/payment/momo/return
MOMO_IPN_URL=https://your-backend-domain.com/api/payment/webhook/momo

ZALOPAY_APP_ID=your_zalopay_app_id
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_CREATE_ORDER_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ORDER_URL=https://sb-openapi.zalopay.vn/v2/query

SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
